{
  "$comment": "Hand-maintained provider entries (KoLo 2.0, M9c/M10). These come first in registry.json, in this order, and win over the public catalogue. Entries are configuration identifiers, never product copy. Regenerate registry.json with: pnpm providers:sync",
  "version": 1,
  "providers": [
    {
      "id": "sakura",
      "displayName": "Sakura AI Engine",
      "apiStyle": "openai-compatible",
      "baseUrl": "https://api.ai.sakura.ad.jp/v1",
      "authHeader": "bearer",
      "modelsEndpoint": "/models",
      "regionNote": "Hosted in Japan",
      "defaultModel": "gpt-oss-120b",
      "envVar": "SAKURA_API_KEY",
      "recommended": true
    },
    {
      "id": "openai-compatible",
      "displayName": "OpenAI-compatible endpoint",
      "apiStyle": "openai-compatible",
      "baseUrl": "",
      "authHeader": "bearer",
      "modelsEndpoint": "/models",
      "regionNote": "Wherever the endpoint you give is hosted",
      "requiresBaseUrl": true
    },
    {
      "id": "ollama",
      "displayName": "Ollama",
      "apiStyle": "ollama",
      "baseUrl": "http://127.0.0.1:11434",
      "authHeader": "none",
      "modelsEndpoint": "/api/tags",
      "regionNote": "Local machine",
      "envVar": "OLLAMA_API_KEY"
    },
    {
      "id": "openai",
      "displayName": "OpenAI",
      "apiStyle": "openai-compatible",
      "baseUrl": "https://api.openai.com/v1",
      "authHeader": "bearer",
      "modelsEndpoint": "/models",
      "regionNote": "Global; US-hosted by default",
      "envVar": "OPENAI_API_KEY"
    },
    {
      "id": "anthropic",
      "displayName": "Anthropic",
      "apiStyle": "anthropic-messages",
      "baseUrl": "https://api.anthropic.com/v1",
      "authHeader": "x-api-key",
      "modelsEndpoint": "/models",
      "regionNote": "Global; US-hosted by default",
      "defaultModel": "claude-opus-4-6",
      "envVar": "ANTHROPIC_API_KEY"
    },
    {
      "id": "google",
      "displayName": "Google Gemini API",
      "apiStyle": "gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "authHeader": "x-goog-api-key",
      "modelsEndpoint": "/models",
      "regionNote": "Global; region not selectable on this API",
      "defaultModel": "gemini-3-pro-preview",
      "envVar": "GEMINI_API_KEY"
    },
    {
      "id": "mistral",
      "displayName": "Mistral AI",
      "apiStyle": "openai-compatible",
      "baseUrl": "https://api.mistral.ai/v1",
      "authHeader": "bearer",
      "modelsEndpoint": "/models",
      "regionNote": "Hosted in the European Union",
      "envVar": "MISTRAL_API_KEY"
