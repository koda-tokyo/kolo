      "authHeader": "bearer",
      "modelsEndpoint": "/models",
      "regionNote": "Hosted in China",
      "defaultModel": "deepseek-v4-flash",
      "envVar": "DEEPSEEK_API_KEY"
    },
    {
      "id": "groq",
      "displayName": "Groq",
      "apiStyle": "openai-compatible",
