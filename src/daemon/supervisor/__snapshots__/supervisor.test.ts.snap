exports[`service definitions (snapshot per platform) > darwin: launchd plist with KeepAlive and the env-file runner 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by \`kolo service install\`. Secrets belong in /home/tester/.kolo-smoke/env -->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.kodasoken.kolo.smoke</string>
    <key>Comment</key>
    <string>KoLo Gateway (smoke, v2.0.0-test)</string>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/node/bin/node</string>
      <string>/opt/kolo/dist/daemon/supervisor/runner.js</string>
      <string>--env-file</string>
      <string>/home/tester/.kolo-smoke/env</string>
      <string>--pid-file</string>
      <string>/home/tester/.kolo-smoke/run/gateway.pid</string>
      <string>--</string>
      <string>/opt/node/bin/node</string>
      <string>/opt/kolo/dist/entry.js</string>
      <string>gateway</string>
      <string>--port</string>
      <string>18800</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/home/tester/.kolo-smoke</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/home/tester</string>
      <key>KOLO_GATEWAY_PORT</key>
      <string>18800</string>
      <key>KOLO_HOME</key>
      <string>/home/tester/.kolo-smoke</string>
      <key>KOLO_LAUNCHD_LABEL</key>
      <string>com.kodasoken.kolo.smoke</string>
      <key>KOLO_SERVICE_ID</key>
      <string>smoke</string>
      <key>KOLO_SERVICE_KIND</key>
      <string>gateway</string>
      <key>KOLO_SERVICE_MARKER</key>
      <string>KoLo</string>
      <key>KOLO_STATE_DIR</key>
      <string>/home/tester/.kolo-smoke</string>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>3</integer>
    <key>ExitTimeOut</key>
    <integer>15</integer>
    <key>Umask</key>
    <integer>63</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/home/tester/.kolo-smoke/logs/gateway.out.log</string>
    <key>StandardErrorPath</key>
    <string>/home/tester/.kolo-smoke/logs/gateway.err.log</string>
  </dict>
</plist>
"
`;

exports[`service definitions (snapshot per platform) > linux: systemd --user instance unit 1`] = `
"# Generated by \`kolo service install\`. Edit the env file, not this unit:
#   /home/tester/.kolo-smoke/env
[Unit]
Description=KoLo Gateway (smoke, v2.0.0-test)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/node/bin/node /opt/kolo/dist/entry.js gateway --port 18800
WorkingDirectory=/home/tester/.kolo-smoke
Environment=HOME=/home/tester
Environment=KOLO_GATEWAY_PORT=18800
Environment=KOLO_HOME=/home/tester/.kolo-smoke
Environment=KOLO_SERVICE_ID=smoke
Environment=KOLO_SERVICE_KIND=gateway
Environment=KOLO_SERVICE_MARKER=KoLo
Environment=KOLO_STATE_DIR=/home/tester/.kolo-smoke
Environment=KOLO_SYSTEMD_UNIT=kolo-gateway@smoke.service
Environment=PATH=/home/tester/.local/bin:/home/tester/.npm-global/bin:/home/tester/bin:/home/tester/.nvm/current/bin:/home/tester/.fnm/current/bin:/home/tester/.volta/bin:/home/tester/.asdf/shims:/home/tester/.local/share/pnpm:/home/tester/.bun/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/home/tester/.kolo-smoke/env
Restart=always
RestartSec=3
RestartPreventExitStatus=3
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
"
`;

exports[`service definitions (snapshot per platform) > win32: task script and schtasks argv 1`] = `
"@echo off
rem KoLo Gateway (smoke, v2.0.0-test) - generated by "kolo service install". Secrets: \\home\\tester\\AppData\\Local\\KoLo-smoke/env
setlocal
cd /d \\home\\tester\\AppData\\Local\\KoLo-smoke
set "HOME=/home/tester"
set "KOLO_GATEWAY_PORT=18800"
set "KOLO_HOME=\\home\\tester\\AppData\\Local\\KoLo-smoke"
set "KOLO_SERVICE_ID=smoke"
set "KOLO_SERVICE_KIND=gateway"
set "KOLO_SERVICE_MARKER=KoLo"
set "KOLO_STATE_DIR=\\home\\tester\\AppData\\Local\\KoLo-smoke"
set "KOLO_WINDOWS_TASK_NAME=KoLo\\gateway-smoke"
set "PATH=/usr/bin:/bin"
/opt/node/bin/node /opt/kolo/dist/daemon/supervisor/runner.js --env-file \\home\\tester\\AppData\\Local\\KoLo-smoke/env --pid-file \\home\\tester\\AppData\\Local\\KoLo-smoke/run/gateway.pid --restart-loop --restart-sec 3 --log-file \\home\\tester\\AppData\\Local\\KoLo-smoke/logs/gateway.log -- /opt/node/bin/node /opt/kolo/dist/entry.js gateway --port 18800
"
`;

