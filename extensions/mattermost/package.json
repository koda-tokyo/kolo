{
  "name": "@KoLo/mattermost",
  "version": "2026.2.1-kolo.1",
  "description": "KoLo Mattermost channel plugin",
  "type": "module",
  "devDependencies": {
    "kolo": "workspace:@kodasoken/kolo@*"
  },
  "KoLo": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "mattermost",
